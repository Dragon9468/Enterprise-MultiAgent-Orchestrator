# ==============================================================================
# Enterprise Multi-Agent Orchestrator - Git Ignore
# ==============================================================================

# Credentials & Environment
*.env
*.env.local
*.env.*.local
!*.env.example
!**/*.env.example
*.pem
*.key
*.cert

# Node & Next.js Build
node_modules/
*/node_modules/
.next/
*/.next/
out/
*/out/
.turbo/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Python & Caches
__pycache__/
*/__pycache__/
*/**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
build/
dist/
.pytest_cache/

# Databases & Runtime Bloat
pocketbase/pb_data/*
!pocketbase/pb_data/.gitkeep
pocketbase/pocketbase.exe
pocketbase/*.zip
data/
*.db
*.sqlite

# OS & Editor Files
.DS_Store
Thumbs.db
desktop.ini
*.log
*.tmp
tmp/
